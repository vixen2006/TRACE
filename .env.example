POSTGRES_URL=postgresql://trace_user:trace_pass@localhost:5432/trace_db
POSTGRES_USER=trace_user
POSTGRES_PASSWORD=trace_pass
POSTGRES_DB=trace_db

# GitHub OAuth (create at https://github.com/settings/applications/new)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/integrations/github/callback

# LLM (use any OpenAI-compatible provider)
LLM_PROVIDER=openai
LLM_API_KEY=your_llm_api_key
LLM_MODEL=gpt-4o

# App
SECRET_KEY=changeme_generate_with_openssl_rand_hex_32
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
ENVIRONMENT=development

# Token encryption key (32-byte base64-encoded)
ENCRYPTION_KEY=changeme_base64_32_bytes
